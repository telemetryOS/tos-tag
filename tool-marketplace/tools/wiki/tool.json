{
  "id": "telemetryos.wiki",
  "version": "1.3.3",
  "script": "run.sh",
  "operations": [
    {"id": "read", "env": ["WIKI_URL", "WIKI_TOKEN"], "public_env": ["WIKI_URL"], "timeout_seconds": 45, "max_output_bytes": 1048576, "risk": "read", "approval": "never"},
    {"id": "write", "env": ["WIKI_URL", "WIKI_TOKEN"], "public_env": ["WIKI_URL"], "timeout_seconds": 90, "max_output_bytes": 1048576, "risk": "write", "approval": "never"},
    {"id": "delete", "env": ["WIKI_URL", "WIKI_TOKEN"], "public_env": ["WIKI_URL"], "timeout_seconds": 45, "max_output_bytes": 262144, "risk": "destructive", "approval": "always"}
  ]
}
