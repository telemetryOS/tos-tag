# Secret-free local defaults. Copy to the gitignored runtime.env only when needed.
TAG__ENVIRONMENT=development
TAG__HTTP__ADDR=127.0.0.1:8090
TAG__HTTP__READ_HEADER_TIMEOUT=5s
TAG__HTTP__SHUTDOWN_TIMEOUT=10s
TAG__MONGO__URI=mongodb://127.0.0.1:27018
TAG__MONGO__DATABASE=tos_tag
TAG__MONGO__TIMEOUT=5s
TAG__LOGGING__LEVEL=info
TAG__LOGGING__USE_JSON=false
TAG__LOGGING__DISABLE_COLOR=false
TAG__LOGGING__NO_SPLASH=true
# Optional owner-readable JSONL diagnostic log outside the repository.
TAG__LOGGING__FILE_PATH=
TAG__TELEMETRY__SERVICE_NAME=tos-tag
TAG__TELEMETRY__OTEL_ENABLED=false
TAG__SLACK__MODE=stub
TAG__SLACK__LIVE_ENABLED=false
# Live development only. Prefer a secret store; runtime.env is the local fallback.
# Slack calls these App-Level Token, User OAuth Token, and Bot User OAuth Token.
# Socket Mode uses the app-level and bot-user tokens. Explicit context sync uses
# the User OAuth Token read-only to discover visible conversations and backfill
# bounded recent history. Newly discovered channels are observe-only by default.
TAG__SLACK__ORGANIZATION_ID=
TAG__SLACK__APP_ID=
TAG__SLACK__TEAM_ID=
TAG__SLACK__APP_LEVEL_TOKEN=
TAG__SLACK__USER_OAUTH_TOKEN=
TAG__SLACK__BOT_USER_OAUTH_TOKEN=
TAG__SLACK__BOT_USER_ID=
TAG__SLACK__CONTEXT_SYNC_ENABLED=false
TAG__SLACK__CONTEXT_SYNC_LOOKBACK=168h
TAG__SLACK__CONTEXT_SYNC_TIMEOUT=2h
TAG__SLACK__CONTEXT_SYNC_MAX_CHANNELS=500
TAG__SLACK__CONTEXT_SYNC_MAX_MESSAGES=5000
TAG__SLACK__CONTEXT_SYNC_MESSAGES_PER_CHANNEL=100
TAG__SLACK__STUB_QUEUE_SIZE=256
# Optional hard delivery/reaction destination allowlist. Empty defers to live
# channel policy; comma-separate exact Slack channel IDs when constraining tests.
TAG__SLACK__OUTPUT_CHANNEL_IDS=
TAG__AUTH__ENABLED=false
# Required when auth is enabled; load the real value from a secret store.
TAG__AUTH__ADMIN_TOKEN=
TAG__RETENTION__RAW_ENVELOPE=24h
TAG__RETENTION__MESSAGES=720h
TAG__RETENTION__PROMPT=24h
TAG__RETENTION__SWEEP=1m
# These seven partitions must sum exactly to MAX_TOKENS.
TAG__CONTEXT_PACKS__MAX_TOKENS=100000
TAG__CONTEXT_PACKS__SYSTEM=8000
TAG__CONTEXT_PACKS__THREAD=20000
TAG__CONTEXT_PACKS__CHANNEL=20000
TAG__CONTEXT_PACKS__RECENT_ORG=15000
TAG__CONTEXT_PACKS__EVIDENCE=22000
TAG__CONTEXT_PACKS__SITUATION=10000
TAG__CONTEXT_PACKS__HEADROOM=5000
TAG__CLASSIFIER__MODE=shadow
# Secret-free/test default. For the direct OpenAI classifier set provider to
# openai, provide its dedicated key below, and explicitly change mode to live.
# Channel participation policy still controls whether a channel may speak.
TAG__CLASSIFIER__PROVIDER=deterministic
TAG__CLASSIFIER__BASE_URL=https://api.openai.com/v1
# Direct classifier credential. It is held only by the Go control plane and is
# never copied into Codex workers, prompts, logs, or container image metadata.
TAG__CLASSIFIER__OPENAI_API_KEY=
TAG__CLASSIFIER__MODEL=gpt-5.6-luna
TAG__CLASSIFIER__REASONING_EFFORT=none
TAG__CLASSIFIER__TIMEOUT=60s
TAG__CLASSIFIER__MAX_OUTPUT_TOKENS=2048
TAG__CLASSIFIER__ASSIST_THRESHOLD=0.90
TAG__CLASSIFIER__CHANNEL_REPLY_THRESHOLD=0.98
TAG__CLASSIFIER__MAX_RESPONSES_PER_HOUR=120
TAG__CLASSIFIER__MAX_CONCURRENT_JOBS=8
TAG__JOBS__LEASE=30s
TAG__JOBS__POLL=250ms
TAG__JOBS__MAX_ATTEMPTS=3
TAG__JOBS__WORKER_CONCURRENCY=8
TAG__CLASSIFIER__REACTION_EMOJIS=eyes,thinking_face,white_check_mark,warning,rotating_light,hammer_and_wrench,speech_balloon
TAG__CODEX__ENABLED=false
TAG__CODEX__TIMEOUT=15m
TAG__CODEX__COMMAND=codex
# Optional. When empty, the service resolves CODEX_HOME or $HOME/.codex. This
# directory holds Codex App Server login state and must be persisted privately.
TAG__CODEX__HOME=
TAG__CODEX__WORKER_ROOT=/tmp/tos-tag-workers
# Codex App Server authenticates through its own private Codex home. It never
# reuses TAG__CLASSIFIER__OPENAI_API_KEY; that key remains classifier-only.
TAG__MODELS__DEFAULT_PROFILE=chatgpt-luna-max
TAG__MODELS__DEFAULT_PROVIDER=openai
TAG__MODELS__DEFAULT_MODEL=gpt-5.6-luna
TAG__MODELS__DEFAULT_VARIANT=max
# Example: point at telemetryos-agent-skills without copying it into this repo.
TAG__MARKETPLACES__SKILL_ROOT=
TAG__MARKETPLACES__CATALOG_PATH=
# Explicit allowlist. A single environment value injects one skill; use the
# tag config TOML array when selecting more than one.
TAG__MARKETPLACES__INJECTED_SKILLS=
# These two behavioral plugins are loaded in full and injected automatically.
# Their scripts remain excluded from behavioral snapshots; executable helpers
# require the separately reviewed tool marketplace and capability gateway.
TAG__MARKETPLACES__HEADLESS_ROOT=../telemetryos-agent-skills
TAG__MARKETPLACES__HEADLESS_CATALOG_PATH=.claude-plugin/marketplace.json
TAG__MARKETPLACES__HEADLESS_PLUGIN=telemetryos-automation
TAG__MARKETPLACES__BASE_ROOT=../tag-agent-skills
TAG__MARKETPLACES__BASE_CATALOG_PATH=.claude-plugin/marketplace.json
TAG__MARKETPLACES__BASE_PLUGIN=base
# Reviewed executable tool catalog. The model sees only typed operation IDs and
# argv; the control plane derives each manifest-declared credential binding.
TAG__MARKETPLACES__TOOL_ROOT=./tool-marketplace
TAG__MARKETPLACES__TOOL_CATALOG_PATH=catalog.json
TAG__MARKETPLACES__TOOL_PATH=/usr/local/bin:/usr/bin:/bin
# Host root of the Aion-managed source checkout exposed only through the
# reviewed, read-only telemetryos.code tool. The worker never receives this
# path. Container startup always overrides it to /workspace/code after sourcing
# runtime.env.
TAG_AION_DEVELOPER_PATH=..
# Explicitly enables reviewed server-side helper execution. Requires local
# Codex App Server, a configured tool marketplace, and the encrypted keystore.
TAG__MARKETPLACES__TOOLS_ENABLED=false
# Explicit comma-separated tool-ID allowlist.
TAG__MARKETPLACES__INJECTED_TOOLS=
# Example: telemetryos.linear,telemetryos.wiki,telemetryos.otel,telemetryos.device-logs,telemetryos.code
# Optional write-only Mongo keystore. Generate 32 random bytes and base64 them;
# inject the value from an external secret store and never commit it.
TAG__KEYSTORE__ENABLED=false
TAG__KEYSTORE__MASTER_KEY=

# Reviewed helper credentials. Run `make sync-tool-env` to copy only these
# values from the current shell and ~/.config/telemetryos into this ignored
# mode-0600 file without printing them.
LINEAR_API_KEY=
# Wiki inline bodies use the same reviewed WIKI_URL/WIKI_TOKEN binding and do
# not require a worker-visible source path or an additional credential.
WIKI_URL=
WIKI_TOKEN=
SIGNOZ_URL=
SIGNOZ_API_KEY=
DLA_API_BASE_URL=
DLA_API_KEY=
DLA_ENV=
# Optional and not enabled by default because mongo-fetch needs a human-opened
# security-key session first.
MONGO_QA_URI=
