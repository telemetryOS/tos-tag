[Unit]
Description=TelemetryOS tos-tag Slack control plane
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Sources/TelemetryOS/tos-tag
Environment=HOME=%h
ExecStart=%h/Sources/TelemetryOS/tos-tag/deploy/arch/tos-tag-run
Restart=always
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
