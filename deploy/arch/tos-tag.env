# Non-secret host deployment overlay. This file is sourced after runtime.env.
# The host firewall is the explicit authorization boundary for the admin plane.
TAG__HTTP__ADDR=0.0.0.0:8090
TAG__HTTP__ALLOW_UNAUTHENTICATED=true
# Keep disposable workers off the shared /tmp tmpfs, whose per-user quota can
# be exhausted by unrelated host workloads. Local removes each worker after use.
TAG__CODEX__WORKER_ROOT=${HOME}/.local/state/tos-tag/workers
# The reviewed code helper refreshes only the requested repository into
# immutable default-branch snapshots. Semble indexes and its pinned model stay
# in separate owner-only state and installation roots.
TAG_CODE_SNAPSHOT_ROOT=${HOME}/.local/state/tos-tag/code-snapshots
TAG_CODE_INDEX_ROOT=${HOME}/.local/state/tos-tag/code-indexes
TAG_CODE_MODEL_PATH=${HOME}/.local/lib/tos-tag-semantic/releases/semble-0.5.3-model-e9d2a44ca6a05ac6685f3b23709ea57eb7352d5b/model
TAG_CODE_GH_CONFIG_DIR=${HOME}/.config/gh
