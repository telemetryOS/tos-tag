# Non-secret host deployment overlay. This file is sourced after runtime.env.
# The host firewall is the explicit authorization boundary for the admin plane.
TAG__HTTP__ADDR=0.0.0.0:8090
TAG__HTTP__ALLOW_UNAUTHENTICATED=true
# Keep disposable workers off the shared /tmp tmpfs, whose per-user quota can
# be exhausted by unrelated host workloads. Local removes each worker after use.
TAG__CODEX__WORKER_ROOT=${HOME}/.local/state/tos-tag/workers
