#!/usr/bin/env bash
set -euo pipefail

repository="${HOME}/Sources/TelemetryOS/tos-tag"
binary="${HOME}/.local/lib/tos-tag/api"
compose_override="${repository}/deploy/arch/docker-compose.override.yml"
host_environment="${repository}/deploy/arch/tos-tag.env"

# User services do not inherit the interactive Fish PATH. Keep the portable
# per-user binary directory available so worker provisioning can resolve the
# pinned Codex CLI without baking one operator's home directory into config.
export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"

cd "${repository}"

# MongoDB is the host's single bare-metal user unit `mongodb.service` on
# 127.0.0.1:27017 (rs0, auth; credentials live in runtime.env). Wait for it.
mongo_ready=false
for _ in $(seq 1 60); do
  if (exec 3<>/dev/tcp/127.0.0.1/27017) 2>/dev/null; then
    mongo_ready=true
    break
  fi
  sleep 2
done
if [[ "${mongo_ready}" != true ]]; then
  echo "tos-tag MongoDB (mongodb.service, 127.0.0.1:27017) not reachable within 120 seconds" >&2
  exit 1
fi

set -a
source "${repository}/runtime.env"
source "${host_environment}"
set +a

exec "${binary}"
